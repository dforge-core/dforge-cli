{
	"name": "@dforge-core/dforge-cli",
	"version": "0.2.15",
	"description": "dForge CLI - validate, pack, publish, and install dForge modules. Distributes a single-file native binary per platform via optionalDependencies (esbuild-style).",
	"license": "MIT",
	"homepage": "https://github.com/dforge-core/dforge-cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dforge-core/dforge-cli.git"
	},
	"bin": {
		"dforge-cli": "dist/cli.js"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"main": "dist/cli.js",
	"exports": {
		".": "./dist/cli.js",
		"./templates": {
			"types": "./dist/lib.d.ts",
			"import": "./dist/lib.mjs",
			"require": "./dist/lib.js"
		}
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"@dforge-core/dforge-cli-darwin-arm64": "0.2.15",
		"@dforge-core/dforge-cli-darwin-x64": "0.2.15",
		"@dforge-core/dforge-cli-linux-arm64": "0.2.15",
		"@dforge-core/dforge-cli-linux-x64": "0.2.15",
		"@dforge-core/dforge-cli-win32-arm64": "0.2.15",
		"@dforge-core/dforge-cli-win32-x64": "0.2.15"
	}
}
